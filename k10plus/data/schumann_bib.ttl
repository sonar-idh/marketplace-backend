    bf:issuance <http://id.loc.gov/vocabulary/issuance/mono> ;
    bf:media <http://id.loc.gov/vocabulary/mediaTypes/n> ;
    bf:note [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/accmat> ;
        rdfs:label "getrocknete Blüten u. Blattwerk, seidenes Lesebändchen mit Sigellack mit Initiale S"
    ], [
        a bf:Note ;
        rdfs:label "Tinte. - deutsche Schrift. - leere S.: 2, 4-6, 8-10, 12-30, 32-34, 36-42, 44-46, 50-52, 54-60, 62-76, 78-82, 84-98, 100-112, 114-116, 118-128, 130-138, 140-144, 146-170, 172-178, 179-186, 188-190, 192-194, 196, 198-206, 208-214, 216-255; unbeschriebene S: S. 278-352. - Innens. des Einbands eingeklebter Zettel mit Notiz von fremder Hand in Tinte: \"Robert Schumann legte für Clara Wieck dieses \"Brautbuch\" an. Es enthält Aufzeichnungen und Kompositions-Skizzen.\" - Kompositionsskizzen S. 256-277 eh. von Robert Schumann (Nummerierung der Stücke von fremder Hand in Blei): 1: \"Am 17ten [?] März. 38.\", g-moll, 3/4, 8+ Takte; 2: \"17ter März. Trio zu e. Etude\", op. 16/5, 2+ Takte; 3: \"19ter März 38.\", op. 124/9, 8 Takte; 4: \"23 April 38. Da kein Brief von Dir kam\", H-dur, [C], 12+ Takte; 5: \"Etude April 1838\", B-dur, 3/4, 8+ Takte; 6: \"22 April\", Entwurf zu op. 124/19 in As-Dur, 10 Takte; 7: \"Anfang e. musik. Geschichte\", Es-dur, C, 5+ Takte; 8: \"(Im July 37) Liliput.\", c-moll, 2/4, 1+ Takte; 9: \"Um dieselbe Zeit.\", As-dur, 6/8, 4+ Takte; 10: \"Spanisch. September 37.\", e-moll, 3/4, 3 Takte; 11: \"Etude. Februar 38.\", a-moll, C, 2 Takte; 12: \"Ecossaisse. März 1838.\", op. 124/5, 12 Takte; 13: \"Wien. October 1838.\", g-moll, 2/4, 11 Takte; 14: \"In Pauline Garcia's Stammbuch August 1838.\", op. 99/8, 21 Takte; 15: \"Adagio. April 1838.\", Anfangstakte von op. 20, 21 Takte; 16: \"Walzer (1838) März 1838. <Trio.>\", fertiger Entwurf zu op. 124/18, 20+ Takte; 17: \"Vision. Fata Morgana. 13/11 38 Wien.\", op. 124/14, 9 Takte; 18: \"October 1837.\", op. 124/10, 18 Takte; 19: \"Wien. October 1838.\", op. 19 mit eh. Notiz am Ende: \"In Ermangelung besserer Gedanken niedergeschrieben\", 17 Takte; 20: \"Adagio im Frühling 1838.\", As-dur, [4/4], 4+ Takte; 21: \"October 1839. [?]\", op. 4/5, 9 Takte; 22: \"Frühling 1838.\", c-moll, 3/4, 1+ Takte; 23: \"20 Oct. 39.\", Es-dur, 3/4, 4 Takte"
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/binding> ;
        rdfs:label "dunkelblauer Pappeinband, Fadenheftung"
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/related> ;
        rdfs:label "Editionshinweis: Burger, Ernst: Robert Schumann. Eine Lebenschronik in Bildern und Dokumenten, Mainz 1998, S. 172 (Faksimile) [= Robert Schumann. Neue Ausgabe sämtlicher Werke, hg. von der Robert-Schumann-Gesellschaft Düsseldorf durch Akio Mayeda und Klaus Wolfgang Niemöller in Verbindung mit dem Robert-Schumann-Haus Zwickau, Serie VIII, Bd. 1]"
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/related> ;
        rdfs:label "Literaturhinweis: McCorkle, Margit L.: Thematisch-Bibliographisches Werkverzeichnis, hg. von der Robert-Schumann-Gesellschaft, Düsseldorf, Mainz u.a. 2003, S. 788f. [= Robert Schumann. Neue Ausgabe sämtlicher Werke, Serie VIII, Bd. 6]"
    ] ;
