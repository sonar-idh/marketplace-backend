    bf:tableOfContents [
        a bf:TableOfContents ;
        rdfs:label "Daguerrotypie von Robert Schumann (1850)"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Brief von Marie Schumanns Großmutter Mariane Bargiel, ohne Datum"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Zettel \"Ein Wiener Frühjahrs-Hut von Papa Friedrich. Dresden, d. 19 Jan. 1865\""
    ], [
        a bf:TableOfContents ;
        rdfs:label "Haarlocken von Robert u. Clara Schumann"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Lithographie von August Schumann"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Notenausschnitt: Anfangstakte 1-7 der Etüde op. 13 Anhang Nr. 1 in der Handschrift von Johannes Brahms"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Zettelchen \"Zigarettentabak Caporal [...]\", darunter in Blei eh. von Marie Schumann: \"Handschrift von Brahms. Ließ sich in Frankfurt von mir Tabak holen bei Schepeler am Roßwarth 4.X.1895\""
    ], [
        a bf:TableOfContents ;
        rdfs:label "Visitenkarte von Clara Schumann mit eh. Notiz: \"Frkf. d. 23 Jan: 90. erwidert erst jetzt die freundlichen Wünsche durch Krankheit so verspätet und um Nachsicht bittend.\""
    ], [
        a bf:TableOfContents ;
        rdfs:label "Zettel: \"Zur Erinnerung an den Tag der Confirmation\" unterzeichnet von Beichtvater D. Fr. Ahlfeld vom 8.4.1857"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Notenbeispiele \"Kleine Melodien für Marie 4 August 1842.\", 24 Takte für Klavier (einstimmig)"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Notenausschnitt \"Mailied.\", darunter: \"Die Worte sind von Marie u. die Musik vom Papa gemacht. Düsseldorf, im Sept. 1851.\", 24 Takte (zwei Singstimmen, in einem System notiert)"
    ], [
        a bf:TableOfContents ;
        rdfs:label "Blumenzweig \"Aus Julchen's Brautkranz D. 22ten Sept. 1869.\""
    ], [
        a bf:TableOfContents ;
        rdfs:label "Notenausschnitt \"Melodie von Marie\" (Textanfang: Unter den rothen Blumen schlummre), 16 Takte, darunter eh. von Robert Schumann in Blei: \"(d. 8 Juni 1849)\""
    ], [
        a bf:TableOfContents ;
        rdfs:label "Foto von Marie Schumann (1926)"
    ] ;
    bf:title [
        bf:mainTitle "Gedenkbuch für Marie Schumann" ;
        a bf:Title
    ] ;
    a bf:Manuscript, bf:Monograph, bf:Text, bf:Work .

