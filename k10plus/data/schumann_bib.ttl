    bf:media <http://id.loc.gov/vocabulary/mediaTypes/n> ;
    bf:note [
        a bf:Note ;
        rdfs:label "Tinte, Korrekturen in Blei, letzte S. leer. - deutsche Schrift. - Arbeitsmanuskript. - Bl. 4 verso 12 T. gestrichen: entsprechen teilweise der gedruckten Fassung von T. 25-31+ von op. 32/4. - Titel u. Widmung von Clara Schumann auf S. 1, linker Rand: \"Der lieben Frau Szarvadÿ zur Erinnerung. Paris d. 24 April 1862. Clara Schumann.\", Bemerkung von Clara Schumann rechts oben: \"Handschrift von Robert Schumann.\". - Bemerkung von Robert Schumann auf S. 15: \"Hierauf folgt das gedruckte Stück 'Fragment'.\""
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/related> ;
        rdfs:label "Editionshinweis: Boetticher, Wolfgang: Robert Schumanns Klavierwerke, Teil III: Opus 14-133, Wilhelmshaven 2003, S. 150f. [= Quellenkataloge zur Musikgeschichte, hg. von Richard Schaal, Bd. 10b], Faksimile von S. 1 u. 15. - Nauhaus, Gerd: Robert Schumann. Autograph Faschingsschwank aus Wien op. 26, Satz 1 - 3. Ehemals im Besitz von Wilhelmine Clauß-Szárvády, hg. vom Robert-Schumann-Haus Zwickau, Zwickau 1997 [Kulturstiftung der Länder, Bd. 121]. - Sternstunden. Kunstwerke aus zwei Jahrtausenden erworben mit Mitteln der Kulturstiftung der Länder 1988-1998. Jubiläumsausstellung der Kulturstiftung der Länder gemeinsam mit der Staatsgalerie Stuttgart 7. März bis 1. Juni 1998, hg. von Klaus Maurice u. Britta Kaiser-Schuster, Berlin 1998, S. 176-191 (2 Abb.)"
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/related> ;
        rdfs:label "Literaturhinweis: McCorkle, Margit L.: Robert Schumann. Thematisch-Bibliographisches Werkverzeichnis, hg. von der Robert-Schumann-Gesellschaft unter Mitwirkung von Akio Mayeda und der Robert-Schumann-Forschungsstelle Düsseldorf, München 2003, S. 114 u. 134f. - Eigeldinger, Jean-Jacques: Note sur des autographes musicaux inconnus, in: Revue de musique 70/1, 1984, S. 107-117"
    ] ;
    bf:provisionActivity [
        bflc:simpleDate "[vermutlich 20.-24.3.1839]" ;
