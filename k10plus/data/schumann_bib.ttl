    bf:media <http://id.loc.gov/vocabulary/mediaTypes/c> ;
    bf:note [
        a bf:Note ;
        rdfs:label "Haupttitel fingiert - Daguerreotypie von Johann Anton Völlner, Hamburg März 1850 - zwei Ganzfiguren einander zugewandt - links steht Robert Schumann fast im Ganzprofil nach rechts, das Kinn mit der linken Hand gestützt, den Blick nach unten auf die vor einem Pianino sitzende Clara Schumann, sie im Ganzprofil nach links, die rechte Hand auf den Tasten, den Kopf im Halbprofil mit einem freundlichen Blick zum Fotografen"
    ], [
        a bf:Note ;
        rdfs:label "Die Atelieraufnahme der beiden Schumanns war auch Vorbild für einen nach dem Tod von Robert Schumann hergestellten Stahlstich, der 1859 über den Verlag J. Schuberth & Co., Leipzig, Hamburg, New York vertrieben worden ist, auf der die Mimik von Robert Schumann aber ein - gegenüber der vorliegenden Originalaufnahme - deutlich freundlicheres Lächeln zu zeigen scheint. (Quelle: Robert-Schumann-Haus Zwickau)"
    ], [
        a bf:Note, <http://id.loc.gov/vocabulary/mnotetype/repro> ;
        rdfs:label "Online-Ausgabe Berlin Staatsbibliothek zu Berlin - Preußischer Kulturbesitz 2024 1 Online-Ressource Porträts digital"
    ] ;
    bf:provisionActivity [
        bflc:simpleAgent "[Johann Anton Völlner]" ;
