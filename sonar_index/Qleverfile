[data]
NAME              = sonar
BASE_URL          = https://github.com/wallscope/olympics-rdf
GET_DATA_CMD      = curl -sLo olympics.zip -C - ${BASE_URL}/raw/master/data/olympics-nt-nodup.zip && unzip -q -o olympics.zip && rm olympics.zip
DESCRIPTION       = 120 Years of Olympics, data from ${BASE_URL}
TEXT_DESCRIPTION  = All literals, search with FILTER CONTAINS(?var, "...")

[index]
INPUT_FILES     = gnd_data/*.ttl.gz kpe_data/ttl20260217/*.ttl 
MULTI_INPUT_JSON = [{ "cmd": "find gnd_data -maxdepth 1 -name '*.ttl.gz' -print0 | xargs -0 zcat", "format": "ttl", "parallel": "true" },
                    { "cmd": "find kpe_data/ttl20260217 -maxdepth 1 -name '*.ttl' -print0 | xargs -0 cat", "format": "ttl", "parallel": "false" }
#                    ,{ "cmd": "cat export_data/corr.nq", "format": "nq",  "parallel": "true" },
#                    { "cmd": "cat export_data/aggRel.ttl", "format": "ttl", "parallel": "true" }
                    ]
SETTINGS_JSON   = { "ascii-prefixes-only": false, "num-triples-per-batch": 1000000 }
STXXL_MEMORY = 10G
TEXT_INDEX = from_literals

[server]
PORT               = 7019
# ACCESS_TOKEN       = 
MEMORY_FOR_QUERIES = 10G
CACHE_MAX_SIZE     = 2G
TIMEOUT            = 30s
USE_TEXT_INDEX     = no
PERSIST_UPDATES    = true

[runtime]
SYSTEM = native
IMAGE  = docker.io/adfreiburg/qlever:latest

[ui]
UI_CONFIG = olympics
