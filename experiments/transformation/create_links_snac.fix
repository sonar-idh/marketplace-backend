# Copy a new field in nested structure
copy_field("sameAsRelations[].*.uri", "viaf_uri")
# Adding a new field
add_field("_id", "https://d-nb.info/gnd/118515055")

copy_field("viaf_uri", "owl:sameAs") # metafacture expects a key value pair, key being predicate and value being object
retain ("_id", "owl:sameAs")
